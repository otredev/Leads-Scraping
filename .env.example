# Copia este fichero como .env.local y ajusta lo que necesites.

# URL de la REST API de gosom (docker compose up -d la expone en el 8080).
GOSOM_URL=http://localhost:8080

# Módulo de almacenamiento (ver src/modules/index.ts). Por defecto: json-file.
# STORAGE=json-file

# Carpeta donde el almacenamiento json-file guarda búsquedas y leads.
# DATA_DIR=./data
