# Copia este fichero como .env.local y ajusta lo que necesites.

# URL de la REST API de gosom (docker compose up -d la expone en el 8080).
GOSOM_URL=http://localhost:8080

# MongoDB (Atlas o local). Si está definida, se usa MongoDB como almacenamiento.
# Sustituye <db_password> por tu contraseña (codifica caracteres especiales, p. ej. @ → %40).
# MONGODB_URI=mongodb+srv://usuario:<db_password>@cluster.xxxxx.mongodb.net/
# MONGODB_DB=leads_scraping

# Forzar almacenamiento: mongodb | json-file (por defecto: mongodb si hay MONGODB_URI).
# STORAGE=json-file

# Carpeta donde el almacenamiento json-file guarda los datos.
# DATA_DIR=./data

# País para interpretar teléfonos sin prefijo internacional (ISO de 2 letras).
# DEFAULT_COUNTRY=ES

# Días que un lead pasa en la papelera antes de borrarse.
# TRASH_DAYS=30
